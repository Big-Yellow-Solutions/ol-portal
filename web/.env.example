# API Gateway base URL (was CONFIG.apiUrl in frontend/assets/config.js)
NEXT_PUBLIC_API_URL=https://0y24y7945l.execute-api.us-east-1.amazonaws.com

# AWS region for Cognito (was CONFIG.region)
NEXT_PUBLIC_AWS_REGION=us-east-1

# Cognito App Client ID (was CONFIG.clientId)
NEXT_PUBLIC_COGNITO_CLIENT_ID=ad8m33aec2cpfnbbslunefdfv

# Cognito User Pool ID. The old raw-fetch auth flow never needed this, but the
# Amplify Auth library does. Get it from the SAM stack output "UserPoolId"
# (see backend/template.yaml Outputs) after deploying the backend, e.g.:
#   aws cloudformation describe-stacks --stack-name <stack> \
#     --query "Stacks[0].Outputs[?OutputKey=='UserPoolId'].OutputValue" --output text
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
